<Window x:Class="PXToolBoxDev.Diagnostics.PageCaptureReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PX Tool Box DEV — Comparação antes/depois"
        Width="860" Height="640" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E20"
        Loaded="Window_Loaded" Closed="Window_Closed" Activated="Window_Activated">
    <!--
        Resultado da comparação antes/depois (Diagnostics/PageCapture.cs) — só texto, para
        copiar e mandar. O campo "Ferramenta testada" só entra no texto do relatório; nada aqui
        toca no documento. Mesmo ThreadKeyboardRouter das demais janelas, para o campo aceitar
        digitação dentro do CorelDRAW.
    -->
    <Window.Resources>
        <!-- Menu escuro do item do roteiro (mesmo desenho do de Personalizar painel). -->
        <Style x:Key="Px.ContextMenu" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="#F2F2F4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#2E2E32" BorderBrush="#3C3C40" BorderThickness="1" CornerRadius="4" Padding="2" SnapsToDevicePixels="True">
                            <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Px.MenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F2F2F4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="3" Padding="10,4,10,4" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#262629" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#4DA3FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Foreground="#9A9AA0" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Só leitura: nada foi alterado no documento. Escolha o item do roteiro (ou escreva qual ferramenta foi usada entre as duas capturas) e salve na pasta de capturas; anote no campo se algo saiu diferente do pedido." />

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Item do roteiro (CaptureChecklist): preenche o campo abaixo e dá o nome do arquivo
                 em "Salvar na pasta de capturas". Menu escuro montado no código. -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Item do roteiro:" Foreground="#E4E4E6" VerticalAlignment="Center" Margin="0,0,8,6" />
            <Button x:Name="ChecklistItemButton" Grid.Row="0" Grid.Column="1" Click="OnChecklistItemClick" HorizontalContentAlignment="Left"
                    Background="#2E2E32" Foreground="#E4E4E6" BorderBrush="#3C3C40" Padding="8,4,8,4" Margin="0,0,0,6"
                    ToolTip="Escolha qual captura do roteiro é esta. Sem item, o relatório é salvo como &quot;livre&quot;." />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ferramenta testada:" Foreground="#E4E4E6" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="ToolLabelTextBox" Grid.Row="1" Grid.Column="1" TextChanged="OnToolLabelChanged"
                     Background="#2E2E32" Foreground="#E4E4E6" BorderBrush="#3C3C40" BorderThickness="1" Padding="6,4,6,4" />
        </Grid>

        <TextBox Grid.Row="2" x:Name="ReportTextBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Background="#262629" Foreground="#E4E4E6" BorderBrush="#3C3C40" BorderThickness="1" Padding="6" />

        <!-- Status numa linha própria: o nome do arquivo salvo é longo e cortava os botões. -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#B4B4BC" TextWrapping="Wrap" Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Fechar" Click="OnCloseClick" IsCancel="True"
                    Background="#2E2E32" Foreground="#E4E4E6" BorderBrush="#3C3C40" Padding="12,5,12,5" />
            <Button DockPanel.Dock="Right" Content="Salvar como .txt…" Click="OnSaveClick"
                    Background="#2E2E32" Foreground="#E4E4E6" BorderBrush="#3C3C40" Padding="12,5,12,5" Margin="0,0,8,0" />
            <Button DockPanel.Dock="Right" Content="Copiar relatório" Click="OnCopyClick"
                    Background="#2E2E32" Foreground="#E4E4E6" BorderBrush="#3C3C40" Padding="12,5,12,5" Margin="0,0,8,0" />
            <Button DockPanel.Dock="Right" Content="Salvar na pasta de capturas" Click="OnSaveToFolderClick"
                    Background="#4DA3FF" Foreground="#0B1726" FontWeight="SemiBold" Padding="12,5,12,5" Margin="0,0,8,0"
                    ToolTip="Salva o relatório na pasta de capturas do PX DEV, com o nome do item do roteiro. Nunca sobrescreve um relatório anterior." />
        </DockPanel>
    </Grid>
</Window>
