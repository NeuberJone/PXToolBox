<Window x:Class="PXToolBoxDev.Diagnostics.ShapeInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PX Tool Box DEV — Inspecionar Shape.Properties"
        Width="900" Height="640" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E20">
    <!--
        Ferramenta de diagnóstico, exclusiva da distribuição DEV (ver docs/ARCHITECTURE.md) —
        100% somente leitura: nunca cria, altera nem exclui nenhuma Shape.Properties, nem toca
        em nome/camada/documento do objeto. Usada para investigar como o SISBolt marca objetos
        com opções persistentes (ex.: "Tamanho padrão") — ver
        ShapePropertiesInspectorService.cs para a assinatura real da API confirmada por
        reflection antes de implementar. Sem campo editável — não precisa de
        ThreadKeyboardRouter (esse mecanismo é específico do ListForge Integrado).
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="Px.Text" Color="#E4E4E6" />
        <SolidColorBrush x:Key="Px.TextMuted" Color="#9A9AA0" />
        <SolidColorBrush x:Key="Px.Surface1" Color="#262629" />
        <SolidColorBrush x:Key="Px.Surface2" Color="#2E2E32" />
        <SolidColorBrush x:Key="Px.Border" Color="#3C3C40" />
        <SolidColorBrush x:Key="Px.Accent" Color="#4DA3FF" />
        <SolidColorBrush x:Key="Px.AccentText" Color="#0B1726" />
        <SolidColorBrush x:Key="Px.Warn" Color="#E0A33E" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
        </Style>
        <Style x:Key="Px.Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Px.TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Px.Surface2}" />
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Px.Border}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="Px.Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Px.Surface1}" />
            <Setter Property="BorderBrush" Value="{StaticResource Px.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Px.Surface2}" />
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Px.Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource Px.Surface1}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Px.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Px.Border}" />
            <Setter Property="Padding" Value="6,4" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Px.AccentText}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Px.GridText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource Px.Surface1}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Px.Border}" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Px.Card}" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Objeto selecionado" FontWeight="Bold" Margin="0,0,0,6" />
                <TextBlock x:Name="ObjectSummaryText" Style="{StaticResource Px.Muted}" FontFamily="Consolas" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusMessageText" Grid.Row="1" Foreground="{StaticResource Px.Warn}"
                   TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />

        <Border Grid.Row="2" Style="{StaticResource Px.Card}">
            <DockPanel>
                <TextBlock x:Name="PropertiesHeaderText" DockPanel.Dock="Top" FontWeight="Bold" Margin="10,8" Text="Shape.Properties" />
                <DataGrid x:Name="PropertiesGrid" DockPanel.Dock="Top" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="40" ElementStyle="{StaticResource Px.GridText}" />
                        <DataGridTextColumn Header="Índice" Binding="{Binding Index}" Width="60" ElementStyle="{StaticResource Px.GridText}" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" ElementStyle="{StaticResource Px.GridText}" />
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" ElementStyle="{StaticResource Px.GridText}" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" ElementStyle="{StaticResource Px.GridText}" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110" ElementStyle="{StaticResource Px.GridText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterStatusText" Grid.Column="0" Style="{StaticResource Px.Muted}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Atualizar" Click="OnRefreshClick" />
                <Button Content="Copiar tudo" Click="OnCopyAllClick" />
                <Button Content="Salvar relatório..." Click="OnSaveReportClick" />
                <Button Content="Fechar" Click="OnCloseClick" Background="{StaticResource Px.Accent}" Foreground="{StaticResource Px.AccentText}" FontWeight="SemiBold" Margin="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
