<Window x:Class="PXToolBoxDev.Diagnostics.CaptureChecklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PX Tool Box DEV — Roteiro de capturas"
        Width="820" Height="600" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="#1E1E20" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Closed="Window_Closed">
    <!--
        Roteiro das capturas antes/depois que faltam (Diagnostics/CaptureChecklist.cs). Escolher
        um item só deixa ele como o "item atual": a janela de comparação já abre com ele e salva o
        relatório na pasta de capturas (CaptureReportStore). Não lê nem altera o documento; pode
        ficar aberta ao lado do Corel enquanto se faz o teste.
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="Px.Text" Color="#F2F2F4" />
        <SolidColorBrush x:Key="Px.TextMuted" Color="#B4B4BC" />
        <SolidColorBrush x:Key="Px.Surface1" Color="#262629" />
        <SolidColorBrush x:Key="Px.Surface2" Color="#2E2E32" />
        <SolidColorBrush x:Key="Px.Border" Color="#3C3C40" />
        <SolidColorBrush x:Key="Px.Accent" Color="#4DA3FF" />
        <SolidColorBrush x:Key="Px.AccentText" Color="#0B1726" />
        <SolidColorBrush x:Key="Px.Done" Color="#5CC98A" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Px.Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Px.TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Px.Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Px.Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,3" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Px.Surface2}" />
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Px.Border}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Px.Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Px.Surface1}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Px.ItemRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="3" Padding="8,5" Margin="0,1" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Px.Surface2}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Px.Surface2}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Px.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <TextBlock x:Name="ProgressText" FontWeight="Bold" />
            <TextBlock Style="{StaticResource Px.Muted}" Margin="0,4,0,0"
                       Text="Use um documento novo e pequeno, só com os objetos do item. Escolha o item, prepare a página, clique em &quot;Capturar estado (antes)&quot; no painel, faça o que o item pede na ferramenta original e clique em &quot;Comparar com a captura (depois)&quot; → &quot;Salvar na pasta de capturas&quot;. Esta janela pode ficar aberta durante o teste." />
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Px.Surface1}" BorderBrush="{StaticResource Px.Border}"
                BorderThickness="1" CornerRadius="5">
            <ListBox x:Name="ItemsList" Background="Transparent" BorderThickness="0" Padding="4"
                     ItemContainerStyle="{StaticResource Px.ItemRow}" SelectionChanged="OnItemSelected"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="DetailTitle" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="DetailStatus" Style="{StaticResource Px.Muted}" Margin="0,2,0,0" />
                <TextBlock Style="{StaticResource Px.Heading}" Text="1. Prepare a página" />
                <TextBlock x:Name="DetailPrepare" />
                <TextBlock Style="{StaticResource Px.Heading}" Text="2. No painel: Capturar estado (antes)" />
                <TextBlock Style="{StaticResource Px.Heading}" Text="3. Na ferramenta original" />
                <TextBlock x:Name="DetailAction" />
                <TextBlock Style="{StaticResource Px.Heading}" Text="4. No painel: Comparar com a captura (depois)" />
                <TextBlock Style="{StaticResource Px.Muted}"
                           Text="A janela de comparação já abre com este item escolhido. Clique em &quot;Salvar na pasta de capturas&quot;; o item ganha ✓ aqui. Se algo saiu diferente do pedido, escreva no campo antes de salvar." />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Style="{StaticResource Px.Muted}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Fechar" Click="OnCloseClick" IsCancel="True" />
            <Button DockPanel.Dock="Right" Content="Abrir pasta das capturas" Click="OnOpenFolderClick"
                    ToolTip="Abre a pasta onde os relatórios salvos ficam. Mande os arquivos dela." />
        </DockPanel>
    </Grid>
</Window>
