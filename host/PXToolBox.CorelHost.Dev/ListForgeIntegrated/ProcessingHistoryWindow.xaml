<Window x:Class="PXToolBoxDev.ListForgeIntegrated.ProcessingHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PX Tool Box DEV — Histórico de processamentos"
        Width="900" Height="560" MinWidth="620" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E20">
    <!--
        Porta de ListForge/UI/Views/HistoryView.xaml (standalone) para o modo Clássico do
        ListForge Integrado — mesmos dados/ações (Integrations/ListForgeProcessingHistoryService,
        separado do histórico do standalone), tema PX. O standalone não tem exclusão individual
        de registro nem "restaurar" um registro para reabrir a lista — só "Abrir pasta da saída"
        e "Limpar histórico" — por isso esta janela reproduz só essas duas ações (ver comentário
        de ListForgeProcessingHistoryService).
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="Px.Text" Color="#E4E4E6" />
        <SolidColorBrush x:Key="Px.TextMuted" Color="#9A9AA0" />
        <SolidColorBrush x:Key="Px.Surface1" Color="#262629" />
        <SolidColorBrush x:Key="Px.Surface2" Color="#2E2E32" />
        <SolidColorBrush x:Key="Px.Border" Color="#3C3C40" />
        <SolidColorBrush x:Key="Px.Accent" Color="#4DA3FF" />
        <SolidColorBrush x:Key="Px.AccentText" Color="#0B1726" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
        </Style>
        <Style x:Key="Px.Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Px.TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Px.Surface2}" />
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Px.Border}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="Px.Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Px.Surface1}" />
            <Setter Property="BorderBrush" Value="{StaticResource Px.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Px.Surface2}" />
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Px.Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource Px.Surface1}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Px.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Px.Border}" />
            <Setter Property="Padding" Value="6,4" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Px.AccentText}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Px.GridText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource Px.Surface1}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Px.Border}" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Px.Card}" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Histórico de processamentos" FontSize="16" FontWeight="Bold" />
                <TextBlock Style="{StaticResource Px.Muted}" Margin="0,4,0,0"
                           Text="Últimos processamentos com arquivo de saída gerado (Salvar saída, Gerar JSON ou Salvar avançado) — próprio deste módulo, nunca o histórico do ListForge Standalone." />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" SelectionMode="Single"
                      SelectionChanged="OnSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Arquivo" Binding="{Binding SourceDisplayName}" Width="220" ElementStyle="{StaticResource Px.GridText}" />
                    <DataGridTextColumn Header="Data" Binding="{Binding ProcessedAtDisplay}" Width="130" ElementStyle="{StaticResource Px.GridText}" />
                    <DataGridTextColumn Header="Linhas" Binding="{Binding ProcessedLineCount}" Width="70" ElementStyle="{StaticResource Px.GridText}" />
                    <DataGridTextColumn Header="Saída" Binding="{Binding OutputPath}" Width="*" ElementStyle="{StaticResource Px.GridText}" />
                </DataGrid.Columns>
            </DataGrid>

            <Border x:Name="EmptyStateBorder" Style="{StaticResource Px.Card}" Visibility="Collapsed">
                <TextBlock Text="Nenhum processamento foi registrado ainda."
                           Style="{StaticResource Px.Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusText" Style="{StaticResource Px.Muted}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnOpenOutputFolder" Content="Abrir pasta da saída" Click="OnOpenOutputFolder" />
                <Button x:Name="BtnClearHistory" Content="Limpar histórico" Click="OnClearHistory" />
                <Button Content="Fechar" Click="OnCloseClick" Background="{StaticResource Px.Accent}" Foreground="{StaticResource Px.AccentText}" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
