<Window x:Class="PXToolBoxDev.ListForgeIntegrated.WorkProfileNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PX Tool Box DEV — Perfil de trabalho"
        Width="420" SizeToContent="Height" MinWidth="360"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E20"
        Loaded="Window_Loaded" Closed="Window_Closed" Activated="Window_Activated">
    <!--
        Substitui ListForge.UI.Views.InputDialog do standalone (Window própria do projeto
        standalone, fora do núcleo compartilhado) — usada por "Novo..." e "Renomear..." de
        perfis de trabalho (ver docs/listforge-classic-parity.md, grupo "Perfis de trabalho").
        Mesmo ThreadKeyboardRouter das demais janelas, para a caixa de nome aceitar digitação
        normalmente dentro do CorelDRAW.
    -->
    <StackPanel Margin="14">
        <TextBlock x:Name="PromptText" Foreground="#E4E4E6" TextWrapping="Wrap" Margin="0,0,0,10" />

        <TextBox x:Name="NameTextBox" FontFamily="Consolas"
                 Background="#2E2E32" Foreground="#E4E4E6" BorderBrush="#3C3C40" BorderThickness="1"
                 Padding="6" Margin="0,0,0,10" />

        <TextBlock x:Name="StatusText" Foreground="#E0A33E" TextWrapping="Wrap" Margin="0,0,0,10" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnOk" Content="OK" Click="OnOkClick"
                    Background="#4DA3FF" Foreground="#0B1726" FontWeight="SemiBold" Padding="12,5,12,5" Margin="0,0,8,0" />
            <Button Content="Cancelar" Click="OnCancelClick" IsCancel="True"
                    Background="#2E2E32" Foreground="#E4E4E6" BorderBrush="#3C3C40" Padding="12,5,12,5" />
        </StackPanel>
    </StackPanel>
</Window>
