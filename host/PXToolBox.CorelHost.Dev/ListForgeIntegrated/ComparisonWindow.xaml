<Window x:Class="PXToolBoxDev.ListForgeIntegrated.ComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PX Tool Box DEV — Comparação entre entrada e saída"
        Width="1260" Height="820" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E20">
    <!--
        Porta de ListForge/UI/Views/ComparisonWindow.xaml (standalone) para o modo Clássico do
        ListForge Integrado — mesmos dados e categorias (ListForge.Core.Services.ListComparisonService,
        movido para o núcleo compartilhado nesta entrega), tema PX em vez do tema do ListForge.
        Simplificações deliberadas em relação ao standalone: sem o controle customizado
        LineNumberedTextBox (gutter de números de linha) nem o layout responsivo largo/compacto —
        dois TextBox de só leitura com Select()/ScrollToLine() ao selecionar um item, mesmo
        mecanismo já usado em ClassicWorkspaceWindow.OnIssueSelected. Só leitura (sem campo
        editável) — não precisa do ThreadKeyboardRouter.
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="Px.Text" Color="#E4E4E6" />
        <SolidColorBrush x:Key="Px.TextMuted" Color="#9A9AA0" />
        <SolidColorBrush x:Key="Px.Surface0" Color="#1E1E20" />
        <SolidColorBrush x:Key="Px.Surface1" Color="#262629" />
        <SolidColorBrush x:Key="Px.Surface2" Color="#2E2E32" />
        <SolidColorBrush x:Key="Px.Border" Color="#3C3C40" />
        <SolidColorBrush x:Key="Px.Accent" Color="#4DA3FF" />
        <SolidColorBrush x:Key="Px.AccentText" Color="#0B1726" />
        <SolidColorBrush x:Key="Px.Warn" Color="#E0A33E" />
        <SolidColorBrush x:Key="Px.WarnBg" Color="#3A2F18" />

        <Style x:Key="Px.Metric" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Px.Surface2}" />
            <Setter Property="BorderBrush" Value="{StaticResource Px.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
        </Style>
        <Style x:Key="Px.Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Px.TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Px.Surface2}" />
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Px.Border}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Px.Surface1}" />
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Px.Border}" />
            <Setter Property="CaretBrush" Value="{StaticResource Px.Text}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Px.Accent}" />
        </Style>
        <!-- Caixa de filtro: mesmo template escuro de ClassicWorkspaceWindow. Só com
             Background/Foreground, o template padrão do Windows mantinha o fundo claro (fechada e
             na lista aberta) e o texto claro ficava ilegível — baixo contraste relatado pelo
             usuário (2026-11). -->
        <Style x:Key="Px.ComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="Padding" Value="6,4,6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Px.Surface2}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Px.Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource Px.AccentText}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Px.TextMuted}" />
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Px.Surface1}" />
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Px.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3,6,3" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource Px.ComboBoxItem}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" SnapsToDevicePixels="True" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Content="{TemplateBinding SelectionBoxItem}"
                                               ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                               IsHitTestVisible="False" />
                            <Path Width="8" Height="8" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Fill="{StaticResource Px.Accent}" Stretch="Uniform" Data="M 0 0 L 4 4 L 8 0 Z" IsHitTestVisible="False" />
                            <ToggleButton x:Name="Toggle" Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True" Focusable="False" StaysOpen="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource Px.Surface1}" BorderBrush="{StaticResource Px.Border}"
                                        BorderThickness="1" CornerRadius="4" Margin="0,2,0,0"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Px.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Px.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                                <Setter Property="Foreground" Value="{StaticResource Px.TextMuted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Px.Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Px.Surface1}" />
            <Setter Property="BorderBrush" Value="{StaticResource Px.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Px.Surface2}" />
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Px.Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource Px.Surface1}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Px.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Px.Border}" />
            <Setter Property="Padding" Value="6,4" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Px.AccentText}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Px.GridText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource Px.Surface1}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Px.Border}" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="1.4*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Px.Card}" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Resumo da comparação" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                <WrapPanel>
                    <Border Style="{StaticResource Px.Metric}"><TextBlock x:Name="MetricInput" /></Border>
                    <Border Style="{StaticResource Px.Metric}"><TextBlock x:Name="MetricOutput" /></Border>
                    <Border Style="{StaticResource Px.Metric}"><TextBlock x:Name="MetricMatching" /></Border>
                    <Border Style="{StaticResource Px.Metric}"><TextBlock x:Name="MetricReordered" /></Border>
                    <Border Style="{StaticResource Px.Metric}"><TextBlock x:Name="MetricTransformed" /></Border>
                    <Border Style="{StaticResource Px.Metric}"><TextBlock x:Name="MetricChanged" /></Border>
                    <Border Style="{StaticResource Px.Metric}"><TextBlock x:Name="MetricMissing" /></Border>
                    <Border Style="{StaticResource Px.Metric}"><TextBlock x:Name="MetricAdded" /></Border>
                    <Border Style="{StaticResource Px.Metric}"><TextBlock x:Name="MetricUncertain" /></Border>
                    <Border Style="{StaticResource Px.Metric}"><TextBlock x:Name="MetricDuplicates" /></Border>
                </WrapPanel>
                <Border x:Name="StatusBorder" CornerRadius="3" Padding="10,7" Margin="0,2,0,0" BorderThickness="1">
                    <TextBlock x:Name="StatusMessageText" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Diferença anterior" Click="OnPreviousDifference" />
                <Button Content="Próxima diferença" Click="OnNextDifference" />
            </StackPanel>
            <TextBlock Text="Filtro" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="FilterCombo" Width="260" SelectionChanged="OnFilterChanged" Margin="0,0,12,0" />
            <TextBlock x:Name="FilterStatusText" Style="{StaticResource Px.Muted}" VerticalAlignment="Center" />
        </DockPanel>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Px.Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Entrada original" FontWeight="Bold" Margin="10,8" />
                    <TextBox x:Name="InputPane" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="2" />
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Px.Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Saída organizada" FontWeight="Bold" Margin="10,8" />
                    <TextBox x:Name="OutputPane" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="2" />
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Px.Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Diferenças detectadas" FontWeight="Bold" Margin="10,8" />
                    <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" SelectionChanged="OnItemSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Indicator}" Width="78" ElementStyle="{StaticResource Px.GridText}" />
                            <DataGridTextColumn Header="Entrada" Binding="{Binding InputLineDisplay}" Width="62" ElementStyle="{StaticResource Px.GridText}" />
                            <DataGridTextColumn Header="Saída" Binding="{Binding OutputLineDisplay}" Width="58" ElementStyle="{StaticResource Px.GridText}" />
                            <DataGridTextColumn Header="Categoria" Binding="{Binding CategoryLabel}" Width="155" ElementStyle="{StaticResource Px.GridText}" />
                            <DataGridTextColumn Header="Resumo" Binding="{Binding Summary}" Width="*" ElementStyle="{StaticResource Px.GridText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Px.Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="10,8">
                        <TextBlock Text="Detalhamento por campos" FontWeight="Bold" />
                        <TextBlock x:Name="SelectedDetailsTitleText" Style="{StaticResource Px.Muted}" Margin="0,3,0,0" />
                        <TextBlock x:Name="SelectedDetailsText" Style="{StaticResource Px.Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                    <DataGrid x:Name="DifferencesGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Campo" Binding="{Binding FieldName}" Width="125" ElementStyle="{StaticResource Px.GridText}" />
                            <DataGridTextColumn Header="Entrada" Binding="{Binding InputValue}" Width="*" ElementStyle="{StaticResource Px.GridText}" />
                            <DataGridTextColumn Header="Saída" Binding="{Binding OutputValue}" Width="*" ElementStyle="{StaticResource Px.GridText}" />
                            <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="150" ElementStyle="{StaticResource Px.GridText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock x:Name="OutputOriginText" Style="{StaticResource Px.Muted}" />
                <TextBlock Style="{StaticResource Px.Muted}" Margin="0,3,0,0"
                           Text="O relatório pode conter dados da lista. Compartilhe-o somente quando necessário." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Copiar relatório" Click="OnCopyReport" ToolTip="Copia o resumo e as diferenças para a área de transferência." />
                <Button Content="Fechar" Click="OnCloseClick" Background="{StaticResource Px.Accent}" Foreground="{StaticResource Px.AccentText}" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
