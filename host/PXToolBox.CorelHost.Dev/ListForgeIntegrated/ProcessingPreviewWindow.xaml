<Window x:Class="PXToolBoxDev.ListForgeIntegrated.ProcessingPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PX Tool Box DEV — Prévia do processamento"
        Width="620" MinHeight="420" MaxHeight="720" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E20">
    <!--
        Porta de ListForge/UI/Views/ProcessingPreviewDialog.cs (standalone) para o modo Clássico
        do ListForge Integrado — mesma estrutura de seções (Resumo/Tamanhos/Tipos de
        peça/Saída/Avisos/Detalhes dos problemas), tema PX em vez do tema do ListForge. Só
        leitura (sem campo editável) — não precisa do ThreadKeyboardRouter usado por
        ClassicWorkspaceWindow/KeyboardDiagMiniWindow/LinkImportDialog.
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="Px.Text" Color="#E4E4E6" />
        <SolidColorBrush x:Key="Px.TextMuted" Color="#9A9AA0" />
        <SolidColorBrush x:Key="Px.Surface1" Color="#262629" />
        <SolidColorBrush x:Key="Px.Border" Color="#3C3C40" />
        <SolidColorBrush x:Key="Px.Accent" Color="#4DA3FF" />
        <SolidColorBrush x:Key="Px.AccentText" Color="#0B1726" />
        <SolidColorBrush x:Key="Px.Warn" Color="#E0A33E" />
        <Style x:Key="Px.SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Px.SectionLine" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Px.TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="Px.SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Px.Surface1}" />
            <Setter Property="BorderBrush" Value="{StaticResource Px.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="14,10,14,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Text="Prévia do processamento" FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource Px.Text}" Margin="0,0,0,12" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnProcessNow" Content="Processar agora" Click="OnProcessNowClick"
                    Background="{StaticResource Px.Accent}" Foreground="{StaticResource Px.AccentText}"
                    FontWeight="SemiBold" Padding="14,6,14,6" Margin="0,0,8,0" MinWidth="140" />
            <Button x:Name="BtnBack" Content="Voltar" Click="OnBackClick" IsCancel="True"
                    Background="{StaticResource Px.Surface1}" Foreground="{StaticResource Px.Text}"
                    BorderBrush="{StaticResource Px.Border}" Padding="14,6,14,6" MinWidth="100" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Px.SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Resumo" Style="{StaticResource Px.SectionTitle}" />
                        <TextBlock x:Name="SummaryText" Style="{StaticResource Px.SectionLine}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Px.SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Tamanhos" Style="{StaticResource Px.SectionTitle}" />
                        <ItemsControl x:Name="SizesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Px.SectionLine}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Px.SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Tipos de peça" Style="{StaticResource Px.SectionTitle}" />
                        <ItemsControl x:Name="PieceTypesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Px.SectionLine}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Px.SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Saída" Style="{StaticResource Px.SectionTitle}" />
                        <TextBlock x:Name="OutputText" Style="{StaticResource Px.SectionLine}" />
                    </StackPanel>
                </Border>

                <Border x:Name="WarningsCard" Style="{StaticResource Px.SectionCard}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Avisos" Style="{StaticResource Px.SectionTitle}" />
                        <ItemsControl x:Name="WarningsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Px.SectionLine}" Foreground="{StaticResource Px.Warn}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="IssuesCard" Style="{StaticResource Px.SectionCard}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Detalhes dos problemas" Style="{StaticResource Px.SectionTitle}" />
                        <ItemsControl x:Name="IssuesPreviewList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Px.SectionLine}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="BlockedCard" Style="{StaticResource Px.SectionCard}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Confirmação" Style="{StaticResource Px.SectionTitle}" />
                        <TextBlock Style="{StaticResource Px.SectionLine}" Foreground="{StaticResource Px.Warn}"
                                   Text="Nenhum registro válido foi encontrado para processamento ou existem registros inválidos. Volte para corrigir a entrada antes de confirmar." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
