<Window x:Class="PXToolBoxDev.SisboltTools.HorizontalAlignmentLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PX Tool Box DEV — Alinhamento horizontal automático"
        Width="520" SizeToContent="Height" MinWidth="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E20">
    <!--
        Versão PX do "Alinhamento horizontal automático" do SISBolt (HorizontalAlignmentLinkService):
        mostra qual objeto será alinhado e qual é a referência ANTES de salvar; "Trocar papéis"
        inverte; o olho dá zoom na referência (só muda a vista, não o documento). Salvar grava só
        o vínculo, num único Ctrl+Z.
    -->
    <StackPanel Margin="14">
        <TextBlock Foreground="#9A9AA0" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="O objeto a alinhar fica centralizado na horizontal em relação à referência na montagem. Salvar só grava o vínculo (o mesmo identificador nos dois objetos); nada é movido agora." />

        <TextBlock Text="Objeto a alinhar" Foreground="#E4E4E6" FontWeight="SemiBold" />
        <TextBlock x:Name="TargetText" Foreground="#E4E4E6" TextWrapping="Wrap" Margin="0,2,0,10" />

        <TextBlock Text="Referência" Foreground="#E4E4E6" FontWeight="SemiBold" />
        <DockPanel Margin="0,2,0,10">
            <Button x:Name="ZoomReferenceButton" DockPanel.Dock="Right" Click="OnZoomReference" Width="34" Height="28" Margin="8,0,0,0"
                    Background="#2E2E32" Foreground="#E4E4E6" BorderBrush="#3C3C40"
                    ToolTip="Dar zoom na referência (só a vista; o documento não muda)."
                    AutomationProperties.Name="Dar zoom na referência">
                <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
            </Button>
            <TextBlock x:Name="ReferenceText" Foreground="#E4E4E6" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock x:Name="WarningText" Foreground="#E0A33E" TextWrapping="Wrap" Margin="0,0,0,10" />

        <DockPanel LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Trocar papéis" Click="OnSwapRoles"
                    Background="#2E2E32" Foreground="#E4E4E6" BorderBrush="#3C3C40" Padding="12,5,12,5" />
            <Button DockPanel.Dock="Right" Content="Cancelar" Click="OnCancel" IsCancel="True"
                    Background="#2E2E32" Foreground="#E4E4E6" BorderBrush="#3C3C40" Padding="12,5,12,5" />
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Salvar" Click="OnSave"
                    Background="#4DA3FF" Foreground="#0B1726" FontWeight="SemiBold" Padding="12,5,12,5" Margin="0,0,8,0" />
        </DockPanel>
    </StackPanel>
</Window>
