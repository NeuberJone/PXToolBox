<Window x:Class="PXToolBoxDev.Manual.UserManualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PX Tool Box DEV — Manual de uso"
        Width="900" Height="640" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="#1E1E20" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded" Activated="Window_Activated" Closed="Window_Closed">
    <!--
        Manual de uso (Manual/UserManual.cs + user-manual.json). Só texto: não lê nem altera o
        Corel. Não modal e uma só (ShowSingle), para ficar aberto ao lado do Corel. A busca é
        digitada dentro do processo do Corel — por isso o ThreadKeyboardRouter, como nas outras
        janelas com campo de texto.
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="Px.Text" Color="#F2F2F4" />
        <SolidColorBrush x:Key="Px.TextMuted" Color="#B4B4BC" />
        <SolidColorBrush x:Key="Px.Surface1" Color="#262629" />
        <SolidColorBrush x:Key="Px.Surface2" Color="#2E2E32" />
        <SolidColorBrush x:Key="Px.Border" Color="#3C3C40" />
        <SolidColorBrush x:Key="Px.Accent" Color="#4DA3FF" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Px.Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Px.TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Px.PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Px.ToolTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Px.Accent}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Px.Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Px.TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Px.Surface1}" />
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Px.Border}" />
            <Setter Property="CaretBrush" Value="{StaticResource Px.Text}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Px.Accent}" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Px.Surface2}" />
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Px.Border}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Px.Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Px.Surface1}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Px.NavRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="3" Padding="8,5" Margin="0,1" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Px.Surface2}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Px.Surface2}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Px.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Px.NavHeader" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter Margin="9,6,8,2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
            <TextBlock Text="FILTRAR" Style="{StaticResource Px.Label}" Margin="0,0,0,2" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Padding="8,4" Margin="4,0,0,0" Click="OnClearSearchClick"
                        ToolTip="Limpa a busca e mostra tudo de novo." AutomationProperties.Name="Limpar busca" />
                <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged"
                         AutomationProperties.Name="Filtrar o manual"
                         ToolTip="Filtra o manual: só ficam os assuntos, as seções e as ferramentas com todas as palavras digitadas (ex.: laser, camada, Ctrl+Z). Acentos e maiúsculas não importam." />
            </DockPanel>
        </StackPanel>
        <TextBlock x:Name="HintText" Grid.Row="0" Grid.Column="1" Margin="14,0,0,10" VerticalAlignment="Bottom" Style="{StaticResource Px.Muted}" />

        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Px.Surface1}" BorderBrush="{StaticResource Px.Border}"
                BorderThickness="1" CornerRadius="5">
            <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" Padding="4"
                     ItemContainerStyle="{StaticResource Px.NavRow}" SelectionChanged="OnNavSelected"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Assuntos e seções do manual" />
        </Border>

        <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Grid.Column="1" Margin="14,0,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True"
                      AutomationProperties.Name="Conteúdo do manual">
            <StackPanel x:Name="ContentPanel" Margin="0,0,12,0" />
        </ScrollViewer>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="FooterText" DockPanel.Dock="Left" Style="{StaticResource Px.Muted}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Fechar" Click="OnCloseClick" IsCancel="True" />
        </DockPanel>
    </Grid>
</Window>
