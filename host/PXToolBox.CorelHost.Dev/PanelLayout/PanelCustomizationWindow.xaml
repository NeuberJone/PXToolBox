<Window x:Class="PXToolBoxDev.PanelLayout.PanelCustomizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PX Tool Box DEV — Personalizar painel"
        Width="560" Height="760" MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="#1E1E20" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded" Closed="Window_Closed" Activated="Window_Activated">
    <!--
        Rascunho da personalização do painel: seções (nome, ordem, exibir, criar/remover) e em
        que seção cada ferramenta aparece (PanelSectionLayout + PanelCustomization). Nada é
        aplicado nem gravado antes de "Salvar"; "Cancelar"/Esc/fechar descartam o rascunho.
        "Restaurar padrão" só muda o rascunho. Favoritos são outro campo e nunca são tocados aqui.
        ThreadKeyboardRouter: os campos de nome aceitam digitação dentro do CorelDRAW.
    -->
    <Window.Resources>
        <!-- Mais claros que no painel: dentro do Corel o texto desta janela saía acinzentado
             (relato do usuário, dev.76). TextFormattingMode Display deixa a letra nítida. -->
        <SolidColorBrush x:Key="Px.Text" Color="#F2F2F4" />
        <SolidColorBrush x:Key="Px.TextMuted" Color="#B4B4BC" />
        <SolidColorBrush x:Key="Px.RowAlt" Color="#2B2B2F" />
        <SolidColorBrush x:Key="Px.Surface0" Color="#1E1E20" />
        <SolidColorBrush x:Key="Px.Surface1" Color="#262629" />
        <SolidColorBrush x:Key="Px.Surface2" Color="#2E2E32" />
        <SolidColorBrush x:Key="Px.Border" Color="#3C3C40" />
        <SolidColorBrush x:Key="Px.Accent" Color="#4DA3FF" />
        <SolidColorBrush x:Key="Px.AccentText" Color="#0B1726" />
        <SolidColorBrush x:Key="Px.Warn" Color="#E0A33E" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Px.Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Px.TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Px.Surface2}" />
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Px.Border}" />
            <Setter Property="CaretBrush" Value="{StaticResource Px.Text}" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Px.Surface2}" />
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Px.Border}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Px.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Px.Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Px.Surface1}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Px.MoveButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <!-- Escolha da seção de uma ferramenta: botão com o nome da seção + menu escuro. -->
        <Style x:Key="Px.SectionPicker" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="170" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="Px.ContextMenu" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{StaticResource Px.Surface2}" BorderBrush="{StaticResource Px.Border}"
                                BorderThickness="1" CornerRadius="4" Padding="2" SnapsToDevicePixels="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Px.MenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="3" Padding="10,5,10,5" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Px.Surface1}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Px.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Seções" FontWeight="Bold" FontSize="13" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Px.Muted}"
                       Text="Marque para exibir; edite o nome; ▲ e ▼ mudam a ordem; ✕ remove uma seção criada (as ferramentas dela voltam para a seção de origem). Ocultar não apaga nada." />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource Px.Surface1}" BorderBrush="{StaticResource Px.Border}"
                BorderThickness="1" CornerRadius="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SectionRows" Margin="8,6,8,6" />
            </ScrollViewer>
        </Border>

        <Button Grid.Row="2" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnAddSectionClick"
                AutomationProperties.Name="Nova seção" ToolTip="Cria uma seção vazia no fim; depois escolha, em Ferramentas, o que vai nela.">
            <TextBlock Text="+ Nova seção" />
        </Button>

        <StackPanel Grid.Row="3" Margin="0,14,0,8">
            <TextBlock Text="Ferramentas" FontWeight="Bold" FontSize="13" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Px.Muted}"
                       Text="Escolha em que seção cada ferramenta aparece. Uma ferramenta movida fica no fim da seção escolhida; ▲ e ▼ mudam a ordem entre as movidas para a mesma seção. Ferramentas que usam campos da seção de origem (Escudo/Bandeira: nome do layout e pasta; Renomear: o nome) continuam usando esses campos." />
        </StackPanel>

        <Border Grid.Row="4" Background="{StaticResource Px.Surface1}" BorderBrush="{StaticResource Px.Border}"
                BorderThickness="1" CornerRadius="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ToolRows" Margin="8,6,8,6" />
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="StatusMessageText" Grid.Row="5" Foreground="{StaticResource Px.Warn}"
                   Margin="0,8,0,0" Visibility="Collapsed" />

        <Grid Grid.Row="6" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="RestoreDefaultButton" Grid.Column="0" HorizontalAlignment="Left" Margin="0" Click="OnRestoreDefaultClick"
                    ToolTip="Volta o rascunho ao padrão: ordem e nomes originais, todas as seções visíveis, sem seções criadas e cada ferramenta na sua seção. Não altera os favoritos. Ainda é preciso clicar em &quot;Salvar&quot;.">
                <TextBlock Text="Restaurar padrão" />
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Salvar" Click="OnSaveClick" FontWeight="SemiBold"
                        Background="{StaticResource Px.Accent}" Foreground="{StaticResource Px.AccentText}" BorderBrush="{StaticResource Px.Accent}" />
                <Button Content="Cancelar" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
