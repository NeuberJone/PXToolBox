<Window x:Class="PXToolBoxDev.Molds.MoldValidationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PX Tool Box DEV — Validar molde"
        Width="760" Height="520" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="#1E1E20" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Closed="Window_Closed">
    <!--
        Relatório do "Validar molde" (MoldValidationService). Só mostra: não lê o Corel sozinha —
        "Validar de novo" chama o painel, que roda a validação e atualiza esta janela. Não modal e
        uma só (ShowReport), para corrigir no Corel com ela aberta. Sem campo de texto, então sem
        ThreadKeyboardRouter.
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="Px.Text" Color="#F2F2F4" />
        <SolidColorBrush x:Key="Px.TextMuted" Color="#B4B4BC" />
        <SolidColorBrush x:Key="Px.Surface1" Color="#262629" />
        <SolidColorBrush x:Key="Px.Surface2" Color="#2E2E32" />
        <SolidColorBrush x:Key="Px.Border" Color="#3C3C40" />
        <SolidColorBrush x:Key="Px.Accent" Color="#4DA3FF" />
        <SolidColorBrush x:Key="Px.Error" Color="#E5534B" />
        <SolidColorBrush x:Key="Px.Warn" Color="#E0A33E" />
        <SolidColorBrush x:Key="Px.Ok" Color="#57AB5A" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Px.Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Px.TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Px.Surface2}" />
            <Setter Property="Foreground" Value="{StaticResource Px.Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Px.Border}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Px.Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Px.Surface1}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="SummaryText" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="PiecesText" Style="{StaticResource Px.Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource Px.Surface1}" BorderBrush="{StaticResource Px.Border}"
                BorderThickness="1" CornerRadius="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="Problemas encontrados">
                <StackPanel x:Name="IssuesPanel" Margin="10,6" />
            </ScrollViewer>
        </Border>

        <!-- Texto quebra a linha; os botões ficam sempre inteiros, mesmo na largura mínima. -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterText" Style="{StaticResource Px.Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Validar de novo" Click="OnRevalidateClick"
                        ToolTip="Confere a página ativa de novo (depois de corrigir)." />
                <Button Content="Copiar" Click="OnCopyClick"
                        ToolTip="Copia o relatório como texto." />
                <Button Content="Fechar" Click="OnCloseClick" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
